{
	"providers": {
		"default": "anthropic",
		"defaultModel": "claude-haiku-4-5",
		"defaultAgentProvider": "anthropic",
		"defaultAgentModel": "claude-haiku-4-5",
        "intentProvider": "anthropic",
		"intentModel": "claude-haiku-4-5",
		"models": {
			"openai": {
				"small": "gpt-5-nano",
				"mid": "gpt-5-mini",
				"large": "gpt-5.2"
			},
			"anthropic": {
				"small": "claude-haiku-4-5",
				"mid": "claude-sonnet-4-6",
				"large": "claude-opus-4-6"
			}
		}
	},
	"server": {
		"port": 8787,
		"maxBodySize": "2mb",
		"crawl4ai": {
			"url": "http://localhost:11235/extract"
		},
		"braveSearch": {
			"url": "https://api.search.brave.com/res/v1/web/search",
			"defaultCount": 5,
			"maxRetries": 1
		},
		"conversationHistory": {
			"tokenLimit": 4000,
			"charsPerToken": 4
		},
		"openai": {
			"maxRetries": 2,
			"maxCompletionTokens": 4096
		},
		"anthropic": {
			"maxTokens": 4096,
			"maxRetries": 2
		}
	},
	"agent": {
		"portPool": [5001, 5002, 5003, 5004, 5005],
		"timeoutMs": 600000,
		"healthCheckIntervalMs": 1000,
		"healthCheckMaxAttempts": 30,
		"maxRestarts": 1,
		"sessionTtlDays": 7,
		"maxSteps": 20,
		"maxRetryAttempts": 1,
		"consecutiveFailureThreshold": 3,
		"recentActionLookback": 5,
		"defaultPort": 5001,
		"llm": {
			"temperature": 0.1,
			"maxTokens": 2000
		},
		"browser": {
			"headless": false,
			"timeoutMs": 30000,
			"navigationTimeoutMs": 5000,
			"waitPolicy": "networkidle",
			"scrollPixels": 500,
			"contentMaxChars": 3000,
			"linkTextMaxChars": 100,
			"buttonTextMaxChars": 100,
			"charsPerToken": 4
		},
		"execution": {
			"maxCodeLength": 5000,
			"waitTimeoutMs": 5000
		},
		"allowedAPIs": [
			"fillField", "clickButton", "selectOption",
			"selectRadio", "checkCheckbox", "waitForElement"
		]
	},
	"nativeHost": {
		"name": "com.webchat.service_manager",
		"healthCheckIntervalMs": 2000,
		"healthCheckMaxAttempts": 15,
		"pythonPath": "/path/to/crawl_service/venv/bin/python"
	},
	"crawlService": {
		"host": "0.0.0.0",
		"port": 11235
	},
	"extension": {
		"react": {
			"maxIterations": 5,
			"unhelpfulThreshold": 2,
			"minIterationsBeforeBailout": 2,
			"minUsefulContentLength": 100
		},
		"search": {
			"defaultCount": 5
		},
		"crawl4ai": {
			"excludeExternalLinks": true,
			"removeOverlayElements": true,
			"wordCountThreshold": 10
		},
		"profile": {
			"minPassphraseLength": 4,
			"defaultCountry": "United States"
		},
		"userId": 1
	}
}
